# MongoDB connection string (Atlas or local)
# Atlas format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sdlc-tracker
MONGODB_URI=mongodb://localhost:27017/sdlc-tracker

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-32-byte-string

# App URL (http://localhost:3000 in dev, production URL on Vercel)
NEXTAUTH_URL=http://localhost:3000
